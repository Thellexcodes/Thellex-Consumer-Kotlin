<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools">
    <!-- Permissions -->
    <uses-feature
            android:name="android.hardware.camera"
            android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.CAMERA" />

    <supports-screens
            android:anyDensity="true"
            android:largeScreens="true"
            android:normalScreens="true"
            android:smallScreens="true"
            android:xlargeScreens="true" />

    <application
            android:allowBackup="true"
            android:dataExtractionRules="@xml/data_extraction_rules"
            android:fullBackupContent="@xml/backup_rules"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:networkSecurityConfig="@xml/network_security_config"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:supportsRtl="true"
            android:theme="@style/Theme.Thellex"
            android:usesCleartextTraffic="true"
            tools:targetApi="31">
        <activity
                android:name=".features.fiat.FiatRampTransactionsDetailActivity"
                android:exported="false" />
        <activity
                android:name=".features.fiat.OffRampSummaryActivity"
                android:exported="false" />
        <activity
                android:name=".features.fiat.PaymentMethodActivity"
                android:exported="false"
                android:theme="@style/Theme.Thellex" />
        <activity
                android:name=".features.fiat.FiatRampTransactionsActivity"
                android:exported="false" />
        <activity
                android:name=".features.fiat.FiatWithdrawActivity"
                android:exported="false" />
        <activity
                android:name=".features.fiat.OnRampFiatSummaryActivity"
                android:exported="false" />
        <activity
                android:name=".features.onboarding.NotificationPermissionActivity"
                android:exported="false" /> <!-- Launcher activity -->
        <activity
                android:name=".features.onboarding.LauncherActivity"
                android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity> <!-- Main Dashboard -->
        <activity
                android:name=".features.dashboard.ui.MainActivity"
                android:exported="false"
                android:screenOrientation="portrait"
                android:theme="@style/Theme.Thellex" /> <!-- Onboarding -->
        <activity
                android:name=".features.onboarding.OnboardingActivity"
                android:exported="false"
                android:screenOrientation="portrait"
                android:theme="@style/Theme.Thellex" /> <!-- Fiat Features -->
        <activity
                android:name=".features.fiat.CryptoToFiatOffRampActivity"
                android:exported="false" />
        <activity
                android:name=".features.fiat.FiatToCryptoOnRampActivity"
                android:exported="false" />
        <activity
                android:name=".features.profile.ProfileActivity"
                android:exported="false" /> <!-- Notifications -->
        <activity
                android:name=".features.notifications.ui.NotificationsActivity"
                android:exported="false"
                android:screenOrientation="portrait" /> <!-- KYC -->
        <activity
                android:name=".features.kyc.ui.FaceVerificationActivity"
                android:exported="false"
                android:screenOrientation="portrait" />
        <activity
                android:name=".features.kyc.ui.basic.PassportActivity"
                android:exported="false"
                android:screenOrientation="portrait" />
        <activity
                android:name=".features.kyc.ui.StartKycActivity"
                android:exported="false"
                android:screenOrientation="portrait" />
        <activity
                android:name=".features.kyc.ui.basic.BasicKycRequirementsActivity"
                android:exported="false"
                android:screenOrientation="portrait" />
        <activity
                android:name=".features.kyc.ui.basic.BasicKycStep1Activity"
                android:exported="false"
                android:screenOrientation="portrait" />
        <activity
                android:name=".features.kyc.ui.basic.BasicKycStep2Activity"
                android:exported="false"
                android:screenOrientation="portrait" />
        <activity
                android:name=".features.kyc.ui.basic.BasicKycAttestationActivity"
                android:exported="false"
                android:screenOrientation="portrait" />
        <activity
                android:name=".features.kyc.ui.basic.KycSuccessActivity"
                android:exported="false"
                android:screenOrientation="portrait" /> <!-- Wallet -->
        <activity
                android:name=".features.wallet.ui.WalletAssetsActivity"
                android:exported="false"
                android:screenOrientation="portrait" />
        <activity
                android:name=".features.wallet.ui.AssetBalanceActivity"
                android:exported="false"
                android:screenOrientation="portrait" />
        <activity
                android:name=".features.wallet.ui.AssetDepositActivity"
                android:exported="false"
                android:screenOrientation="portrait" />
        <activity
                android:name=".features.wallet.ui.TransactionSuccessActivity"
                android:exported="false"
                android:screenOrientation="portrait" />
        <activity
                android:name=".features.wallet.ui.WithdrawToCryptoWalletActivity"
                android:exported="false"
                android:screenOrientation="portrait" /> <!-- Auth -->
        <activity
                android:name=".features.auth.ui.AuthVerificationActivity"
                android:exported="false"
                android:screenOrientation="portrait"
                android:theme="@style/Theme.Thellex" />
        <activity
                android:name=".features.auth.ui.LoginPinActivity"
                android:exported="false"
                android:screenOrientation="portrait" />
        <activity
                android:name=".features.auth.ui.LoginActivity"
                android:exported="false"
                android:label="@string/title_activity_login"
                android:screenOrientation="portrait" /> <!-- POS -->
        <activity
                android:name=".features.pos.ui.POSWithdrawalSummaryActivity"
                android:exported="false"
                android:screenOrientation="portrait" />
        <activity
                android:name=".features.pos.ui.SelectCryptoCurrencyActivity"
                android:exported="false"
                android:screenOrientation="portrait" />
        <activity
                android:name=".features.pos.ui.POSQuickActionsActivity"
                android:exported="false"
                android:screenOrientation="portrait"
                android:theme="@style/Theme.Thellex" />
        <activity
                android:name=".features.pos.ui.POSHomeActivity"
                android:exported="false"
                android:label="POSActivity"
                android:screenOrientation="portrait" />
        <activity
                android:name=".features.pos.ui.POSChooseCryptoActivity"
                android:exported="false"
                android:label="POSChooseCryptoActivity"
                android:screenOrientation="portrait" />
        <activity
                android:name=".features.pos.ui.SelectReceiverTypeActivity"
                android:exported="false"
                android:label="POSReceiverTypeActivity"
                android:screenOrientation="portrait" />
        <activity
                android:name=".features.pos.ui.GeneratePOSAddressActivity"
                android:exported="false"
                android:label="POSAddressGeneratorActivity"
                android:screenOrientation="portrait" /> <!-- Barcode scanner -->
        <activity
                android:name="com.journeyapps.barcodescanner.CaptureActivity"
                android:screenOrientation="fullSensor"
                tools:replace="screenOrientation" /> <!-- Firebase service -->
        <service
                android:name=".network.services.FirebaseManager"
                android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>