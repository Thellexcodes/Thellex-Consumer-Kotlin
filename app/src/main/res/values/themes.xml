<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Thellex" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.Thellex" parent="Base.Theme.Thellex" />

    <style name="Theme.YourApp.BottomSheetDialog" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/YourAppBottomSheet</item>
    </style>

    <style name="YourAppBottomSheet" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="Theme.Thellex.Launcher" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/midnight</item>
        <item name="windowSplashScreenBackground">@color/white</item> <!-- background color -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/thellex_logo_dark</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/white</item> <!-- optional circle behind icon -->
        <item name="postSplashScreenTheme">@style/Theme.Thellex</item> <!-- theme after splash ends -->
    </style>
</resources>