<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme -->
    <style name="Theme.MyApp" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand colors -->
        <item name="colorPrimary">@color/darkBlue</item>

        <!-- System UI customization -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/midnight</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">false</item>
    </style>

    <style name="BottomNavText" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/kumbhsans_bold</item>
    </style>

    <style name="BottomNavText.Inactive" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">@font/kumbhsans_regular</item>
    </style>

    <style name="PinButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:backgroundTint">#EEEEEE</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="PinDot">
        <item name="android:layout_width">21dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:text">●</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/steelBlueGrey</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_margin">8dp</item>
    </style>

    <style name="LoginPinButtonStyle">
        <item name="android:layout_width">69dp</item>
        <item name="android:layout_height">69dp</item>
        <item name="android:textSize">24sp</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:fontFamily">@font/outfit_light</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@drawable/keypad_button_bg</item>
    </style>

    <style name="EnterAmountButtonPinStyle">
        <item name="android:layout_width">69dp</item>
        <item name="android:layout_height">69dp</item>
        <item name="android:textSize">24sp</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:fontFamily">@font/outfit_light</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@drawable/keypad_button_bg</item>
    </style>

    <style name="RoundedImage" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="zxing_CaptureTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="FullScreenBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/FullScreenBottomSheetStyle</item>
    </style>

    <style name="FullScreenBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:layout_height">match_parent</item>
    </style>

