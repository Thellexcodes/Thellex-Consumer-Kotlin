<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/profileMain"
        android:layout_width="match_parent"
        android:background="@drawable/general_gradient_background"
        android:layout_height="match_parent"
        tools:context=".features.profile.ProfileActivity">

    <!-- Top App Bar -->
    <include
            android:id="@+id/profile_include_top_app_bar"
            layout="@layout/top_app_bar"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    <!-- Profile Info -->
    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/profileInfoWrapper"
            android:layout_width="match_parent"
            android:layout_height="159dp"
            android:layout_marginTop="@dimen/dp_28"
            android:padding="19dp"
            android:background="@drawable/img_profile_info_bg"
            app:layout_constraintTop_toBottomOf="@id/profile_include_top_app_bar">

        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/profileAvatarWrapper"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/rounded_border_white"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

            <TextView
                    android:id="@+id/profileAvatarText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hi!"
                    android:textColor="@color/darkBlue"
                    android:textSize="14dp"
                    android:fontFamily="@font/kumbhsans_medium"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
                android:id="@+id/profileNameEmailWrapper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginTop="13dp"
                app:layout_constraintTop_toBottomOf="@id/profileAvatarWrapper">

            <TextView
                    android:id="@+id/user_real_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Username"
                    android:textSize="12dp"
                    android:textColor="@color/steelBlueGrey"
                    android:fontFamily="@font/kumbhsans_bold"/>

            <TextView
                    android:id="@+id/user_email"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="test@email.com"
                    android:textSize="10sp"
                    android:textColor="@color/steelBlueGrey"
                    android:fontFamily="@font/kumbhsans_regular"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Actions -->
    <LinearLayout
            android:id="@+id/actionsWrapper"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/profileInfoWrapper">

        <!-- Logout -->
        <LinearLayout
                android:id="@+id/logoutWrapper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal"
                android:padding="12dp">

            <TextView
                    android:id="@+id/logoutText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/log_out"
                    android:textColor="@color/white"
                    android:drawableStart="@drawable/icon_exit"
                    android:drawablePadding="20dp"
                    android:fontFamily="@font/kumbhsans_regular"/>
        </LinearLayout>

        <!-- All Transactions (Initially hidden) -->
        <LinearLayout
                android:id="@+id/allTransactionsWrapper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal"
                android:padding="12dp"
                android:background="?attr/selectableItemBackground">

            <TextView
                    android:id="@+id/allTransactionsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All Transactions"
                    android:textColor="@color/white"
                    android:drawableStart="@drawable/icon_exit"
                    android:drawablePadding="20dp"
                    android:fontFamily="@font/kumbhsans_regular"/>
        </LinearLayout>

        <!-- All Transactions (Initially hidden) -->
        <LinearLayout
                android:id="@+id/allRevenueWrapper"
                android:layout_width="match_parent"
                android:visibility="gone"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal"
                android:padding="12dp"
                android:background="?attr/selectableItemBackground">

            <TextView
                    android:id="@+id/allRevenueText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/revenue"
                    android:textColor="@color/white"
                    android:drawableStart="@drawable/icon_exit"
                    android:drawablePadding="20dp"
                    android:fontFamily="@font/kumbhsans_regular"/>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
