<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/ramp_transaction_detail_root"
        android:background="@drawable/general_gradient_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".features.fiat.FiatRampTransactionsDetailActivity">

        <include
                android:id="@+id/ramp_top_app_bar"
                layout="@layout/top_app_bar"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
                android:id="@+id/on_ramp_transaction_info"
                android:layout_marginTop="@dimen/dp_26"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                app:layout_constraintTop_toBottomOf="@id/ramp_top_app_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                        android:id="@+id/ramp_status_label"
                        android:text="STATUS"
                        android:fontFamily="@font/kumbhsans_bold"
                        android:paddingHorizontal="@dimen/dp_6"
                        android:paddingVertical="@dimen/dp_3"
                        android:textSize="@dimen/sp_10"
                        android:background="@drawable/rounded_golden_yellow_shape"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                <TextView
                        android:id="@+id/ramp_action_label"
                        android:text=""
                        android:fontFamily="@font/kumbhsans_bold"
                        android:layout_marginTop="@dimen/dp_11"
                        android:paddingHorizontal="@dimen/dp_6"
                        android:textColor="@color/steelBlueGrey"
                        android:paddingVertical="@dimen/dp_3"
                        android:textSize="@dimen/sp_12"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                <TextView
                        android:id="@+id/ramp_amount"
                        android:text="0.00"
                        android:fontFamily="@font/outfit_bold"
                        android:layout_marginTop="@dimen/dp_11"
                        android:paddingHorizontal="@dimen/dp_6"
                        android:paddingVertical="@dimen/dp_3"
                        android:textColor="@color/white"
                        android:textSize="@dimen/sp_32"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                <TextView
                        android:id="@+id/ramp_timestamp"
                        android:text="2 Jul, 3:07pm"
                        android:fontFamily="@font/kumbhsans_light"
                        android:layout_marginTop="@dimen/dp_2"
                        android:paddingHorizontal="@dimen/dp_6"
                        android:paddingVertical="@dimen/dp_3"
                        android:textColor="@color/white"
                        android:textSize="@dimen/sp_10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                <TextView
                        android:id="@+id/ramp_details_title"
                        android:text="@string/transaction_details"
                        android:fontFamily="@font/kumbhsans_bold"
                        android:layout_marginTop="@dimen/dp_26"
                        android:paddingHorizontal="@dimen/dp_6"
                        android:paddingVertical="@dimen/dp_3"
                        android:textColor="@color/white"
                        android:textSize="@dimen/sp_10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />
        </LinearLayout>

        <include
                android:visibility="gone"
                android:id="@+id/off_ramp_transaction_details"
                layout="@layout/fiat_off_ramp_transaction_details"
                app:layout_constraintTop_toBottomOf="@id/on_ramp_transaction_info"
                android:layout_marginTop="@dimen/dp_26"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        <include
                android:visibility="gone"
                android:id="@+id/on_ramp_transaction_details"
                layout="@layout/fiat_on_ramp_transaction_detail"
                app:layout_constraintTop_toBottomOf="@id/on_ramp_transaction_info"
                android:layout_marginTop="@dimen/dp_26"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/on_ramp_share_receipt_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/button_ripple_golden_yellow"
                android:text="Share Receipt"
                android:elevation="0dp"
                android:fontFamily="@font/kumbhsans_bold"
                android:textColor="@color/dark_purple"
                android:textSize="10sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>