<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/itemNetworkContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_border"
        android:orientation="vertical"
        android:padding="12dp">

    <TextView
            android:id="@+id/textNetworkName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BNB Smart Chain (BEP 20)"
            android:textColor="@color/white"
            android:fontFamily="@font/kumbhsans_regular"
            android:textSize="@dimen/sp_14" />

    <TextView
            android:id="@+id/textNetworkFee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fee 0.00USDT"
            android:textColor="@color/steelBlueGrey"
            android:fontFamily="@font/kumbhsans_regular"
            android:textSize="@dimen/sp_10"
            android:layout_marginTop="@dimen/dp_5" />

    <TextView
            android:id="@+id/textNetworkMinWithdrawal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Minimum Withdrawal 10 USDT"
            android:textColor="@color/steelBlueGrey"
            android:fontFamily="@font/kumbhsans_regular"
            android:textSize="@dimen/sp_10"
            android:layout_marginTop="@dimen/dp_5" />

    <TextView
            android:id="@+id/textNetworkArrivalTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Arrival Time ≈ 1 mins"
            android:textColor="@color/steelBlueGrey"
            android:fontFamily="@font/kumbhsans_regular"
            android:textSize="@dimen/sp_10"
            android:layout_marginTop="@dimen/dp_5" />
</LinearLayout>
