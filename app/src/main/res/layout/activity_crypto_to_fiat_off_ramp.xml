<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/general_gradient_background"
        tools:context=".features.fiat.CryptoToFiatOffRampActivity">

    <include
            android:id="@+id/include_top_app_bar"
            layout="@layout/top_app_bar"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_pending_transactions_wrapper"
            android:background="@drawable/rounded_border_bright_blue_sky"
            android:paddingHorizontal="14dp"
            app:layout_constraintTop_toBottomOf="@id/include_top_app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <LinearLayout
                android:id="@+id/layout_pending_transactions_info"
                android:paddingVertical="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent">

            <ImageView
                    android:id="@+id/icon_pending_clock"
                    android:src="@drawable/icon_clock"
                    android:layout_width="13dp"
                    android:layout_height="13dp"/>

            <TextView
                    android:id="@+id/text_pending_transactions_count"
                    android:textSize="12sp"
                    android:fontFamily="@font/kumbhsans_bold"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/darkBlue"
                    android:text="0 PENDING TRANSACTIONS"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
                android:id="@+id/layout_pending_transactions_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            <TextView
                    android:id="@+id/text_view_pending_transactions"
                    android:fontFamily="@font/kumbhsans_regular"
                    android:textSize="10sp"
                    android:text="VIEW"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            <ImageView
                    android:id="@+id/icon_arrow_right"
                    android:src="@drawable/icon_arror_right"
                    android:layout_width="13dp"
                    android:layout_height="13dp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
            android:visibility="gone"
            android:id="@+id/crypto_fiat_balance_overview"
            app:layout_constraintTop_toBottomOf="@id/layout_pending_transactions_wrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:background="@drawable/img_rounded_darkblue_bg"
            android:padding="10dp">

        <LinearLayout
                android:id="@+id/crypto_wallet_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent">

            <ImageView
                    android:id="@+id/crypto_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/icon_usdc" />

            <TextView
                    android:id="@+id/text_crypto_wallet_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/kumbhsans_semibold"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:text="" />
        </LinearLayout>

        <LinearLayout
                android:id="@+id/crypto_balance_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                    android:id="@+id/text_crypto_balance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/kumbhsans_bold"
                    android:textColor="@color/white"
                    android:text="0.00"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                    android:id="@+id/icon_balance_visibility"
                    android:src="@drawable/icon_eye_open"
                    android:layout_marginStart="5dp"
                    android:layout_width="18dp"
                    android:layout_height="18dp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/crypto_fiat_input_container"
            app:layout_constraintTop_toBottomOf="@id/crypto_fiat_balance_overview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="21dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

        <!-- Input Fields -->
        <LinearLayout
                android:id="@+id/input_fields_wrapper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                    android:id="@+id/bank_account_info"
                    android:background="@drawable/rounded_border"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:paddingVertical="5dp"
                    android:paddingHorizontal="15dp"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                <ImageView
                        android:id="@+id/icon_bank_info"
                        android:src="@drawable/icon_info_circle"
                        android:layout_width="15dp"
                        android:layout_height="15dp"/>
                <TextView
                        android:id="@+id/text_bank_info"
                        android:textSize="8sp"
                        android:fontFamily="@font/kumbhsans_regular"
                        android:layout_marginLeft="@dimen/margin_7dp"
                        android:textColor="@color/white"
                        android:text="Funds are only sent to a bank account that matches your verified name on Thellex."
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- CRYPTO INPUT -->
            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/crypto_input_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rounded_border_midnight">

                <TextView
                        android:id="@+id/label_crypto_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Crypto Amount"
                        android:textSize="10sp"
                        android:textColor="@color/white"
                        android:fontFamily="@font/kumbhsans_light"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/crypto_amount_input_wrapper"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:layout_constraintTop_toBottomOf="@id/label_crypto_amount"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                    <EditText
                            android:id="@+id/edittext_crypto_amount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:hint="0.00"
                            android:inputType="numberDecimal"
                            android:fontFamily="@font/outfit_bold"
                            android:textColor="@color/white"
                            android:textColorHint="@color/steelBlueGrey"
                            android:textSize="24sp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/crypto_currency_selector"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/crypto_currency_selector"
                            android:layout_width="112dp"
                            android:layout_height="46dp"
                            android:background="@drawable/rounded_border"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintVertical_bias="0.0">

                        <ImageView
                                android:id="@+id/assetIcon"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginEnd="8dp"
                                android:src="@drawable/icon_usdc"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent" />

                        <TextView
                                android:id="@+id/text_crypto_currency"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="USDC"
                                android:layout_marginStart="10dp"
                                android:textSize="10sp"
                                android:textColor="@color/steelBlueGrey"
                                android:fontFamily="@font/kumbhsans_regular"
                                app:layout_constraintStart_toEndOf="@id/assetIcon"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        app:layout_constraintTop_toBottomOf="@id/crypto_amount_input_wrapper"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                    <TextView
                            android:id="@+id/textAvailableBalance"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="AVAILABLE BALANCE: 0.00"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:fontFamily="@font/kumbhsans_light"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/buttonMax"
                            app:layout_constraintHorizontal_bias="0" />

                    <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/buttonMax"
                            android:layout_width="41dp"
                            android:layout_height="22dp"
                            android:text="MAX"
                            android:textAllCaps="true"
                            android:textSize="10sp"
                            android:textColor="@color/white"
                            android:background="@drawable/rounded_badge_primary_bg"
                            android:fontFamily="@font/kumbhsans_regular"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- FIAT INPUT -->
            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/fiat_input_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/rounded_border_midnight">

                <TextView
                        android:id="@+id/label_fiat_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fiat Amount"
                        android:textSize="10sp"
                        android:textColor="@color/white"
                        android:fontFamily="@font/kumbhsans_light"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/fiat_amount_input_wrapper"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:layout_constraintTop_toBottomOf="@id/label_fiat_amount"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                    <EditText
                            android:id="@+id/edittext_fiat_amount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:hint="0.00"
                            android:inputType="none"
                            android:focusable="false"
                            android:fontFamily="@font/outfit_bold"
                            android:textColor="@color/white"
                            android:textColorHint="@color/steelBlueGrey"
                            android:textSize="24sp"
                            android:background="@null"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/fiat_currency_selector"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/fiat_currency_selector"
                            android:layout_width="112dp"
                            android:layout_height="46dp"
                            android:background="@drawable/rounded_border"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">

                        <ImageView
                                android:id="@+id/fiat_currency_icon"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginEnd="8dp"
                                android:src="@drawable/icon_nigerian_flag"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent" />

                        <TextView
                                android:id="@+id/text_fiat_currency"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="NGN"
                                android:layout_marginStart="10dp"
                                android:textSize="10sp"
                                android:textColor="@color/steelBlueGrey"
                                android:fontFamily="@font/kumbhsans_regular"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toEndOf="@id/fiat_currency_icon" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>


                <androidx.constraintlayout.widget.ConstraintLayout
                        app:layout_constraintTop_toBottomOf="@id/fiat_amount_input_wrapper"
                        android:visibility="gone"
                        android:id="@+id/price_info_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent">

                    <LinearLayout
                            android:id="@+id/price_label_container"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">

                        <ImageView
                                android:id="@+id/icon_price_info"
                                android:layout_width="13dp"
                                android:layout_height="13dp"
                                android:src="@drawable/icon_info_circle"
                                android:contentDescription="Price Icon"
                                android:layout_marginEnd="4dp" />

                        <TextView
                                android:id="@+id/text_rate_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rate"
                                android:textSize="10sp"
                                android:textColor="@color/white"
                                android:fontFamily="@font/kumbhsans_light" />
                    </LinearLayout>

                    <TextView
                            android:id="@+id/text_rate_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="≅ "
                            android:textSize="14sp"
                            android:textColor="@color/white"
                            android:fontFamily="@font/kumbhsans_bold"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>


            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                    android:id="@+id/payment_reason_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                <TextView
                        android:id="@+id/label_payment_reason"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:fontFamily="@font/kumbhsans_light"
                        android:textSize="10sp"
                        android:text="Reason"
                        android:textColor="@color/white" />

                <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/payment_reason_input_wrapper"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                    <EditText
                            android:id="@+id/edittext_payment_reason"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Select Reason"
                            android:textColorHint="@color/steelBlueGrey"
                            android:textSize="12sp"
                            android:fontFamily="@font/kumbhsans_regular"
                            android:textColor="@color/white"
                            android:background="@drawable/rounded_edittext_midnight_bg"
                            android:paddingVertical="15dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="48dp"
                            android:focusable="false"
                            android:clickable="true"
                            android:inputType="none"
                            android:cursorVisible="false"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />

                    <ImageView
                            android:id="@+id/icon_payment_reason_dropdown"
                            android:layout_width="44dp"
                            android:layout_height="20dp"
                            android:contentDescription="Dropdown Arrow"
                            android:src="@drawable/icon_arrow_down"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/next_button"
                android:paddingHorizontal="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/button_ripple_golden_yellow"
                android:text="Spend"
                android:elevation="0dp"
                android:fontFamily="@font/kumbhsans_bold"
                android:textColor="@color/dark_purple"
                android:textSize="10sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>