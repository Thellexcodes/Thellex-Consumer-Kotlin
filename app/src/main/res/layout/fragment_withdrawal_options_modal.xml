<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/fragment_withdrawal_options_modal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp"
        android:background="@drawable/general_gradient_background">

    <!-- Title -->
    <TextView
            android:id="@+id/text_title_withdrawal_method"
            android:text="Select Withdrawal Method"
            android:textColor="@color/goldenYellow"
            android:fontFamily="@font/outfit_light"
            android:textSize="18sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
            android:id="@+id/container_withdrawal_options"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/text_title_withdrawal_method"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <!-- Withdraw to Crypto -->
        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/onChainWithdrawal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_border"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true">

            <ImageView
                    android:id="@+id/icon_crypto"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/icon_rounded_wallet"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/container_crypto_option"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="13dp"
                    app:layout_constraintStart_toEndOf="@id/icon_crypto"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                <TextView
                        android:id="@+id/text_crypto_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="On-chain Withdrawal"
                        android:textColor="@color/white"
                        android:fontFamily="@font/kumbhsans_semibold"
                        android:textSize="14sp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                <TextView
                        android:id="@+id/text_crypto_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Send crypto assets to your external wallet."
                        android:textColor="@color/white"
                        android:fontFamily="@font/kumbhsans_regular"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp"
                        app:layout_constraintTop_toBottomOf="@id/text_crypto_title"
                        app:layout_constraintStart_toStartOf="parent" />

                <TextView
                        android:id="@+id/badge_kyc_crypto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="KYC Required"
                        android:textColor="@color/pinkRed"
                        android:textSize="8sp"
                        android:layout_marginTop="8dp"
                        app:layout_constraintTop_toBottomOf="@id/text_crypto_desc"
                        app:layout_constraintStart_toStartOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Withdraw to Fiat -->
        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cryptoToFiat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/rounded_border"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true">

            <ImageView
                    android:id="@+id/icon_fiat"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/icon_fiat_btc"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/container_fiat_option"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="13dp"
                    app:layout_constraintStart_toEndOf="@id/icon_fiat"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                <TextView
                        android:id="@+id/text_fiat_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Spend Your Crypto"
                        android:textColor="@color/white"
                        android:fontFamily="@font/kumbhsans_semibold"
                        android:textSize="14sp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                <TextView
                        android:id="@+id/text_fiat_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Easily convert and withdraw your cryptocurrency into your local currency account."
                        android:textColor="@color/white"
                        android:fontFamily="@font/kumbhsans_regular"
                        android:textSize="12sp"
                        android:layout_marginTop="6dp"
                        app:layout_constraintTop_toBottomOf="@id/text_fiat_title"
                        app:layout_constraintStart_toStartOf="parent" />

                <TextView
                        android:id="@+id/badge_kyc_fiat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="KYC Required"
                        android:textColor="@color/pinkRed"
                        android:textSize="8sp"
                        android:layout_marginTop="8dp"
                        app:layout_constraintTop_toBottomOf="@id/text_fiat_desc"
                        app:layout_constraintStart_toStartOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Withdraw to Bank (Moved to Bottom) -->
        <androidx.constraintlayout.widget.ConstraintLayout
                android:visibility="gone"
                android:id="@+id/fiatWithdraw"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/rounded_border"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true">

            <ImageView
                    android:id="@+id/icon_bank"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/iocn_naira_golden"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/container_bank_option"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="13dp"
                    app:layout_constraintStart_toEndOf="@id/icon_bank"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                <TextView
                        android:id="@+id/text_bank_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bank Transfer"
                        android:textColor="@color/white"
                        android:fontFamily="@font/kumbhsans_semibold"
                        android:textSize="12sp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                <TextView
                        android:id="@+id/text_bank_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Withdraw funds directly to your bank account."
                        android:textColor="@color/white"
                        android:fontFamily="@font/kumbhsans_regular"
                        android:textSize="11sp"
                        android:layout_marginTop="8dp"
                        app:layout_constraintTop_toBottomOf="@id/text_bank_title"
                        app:layout_constraintStart_toStartOf="parent" />

                <TextView
                        android:id="@+id/badge_kyc_bank"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="KYC Required"
                        android:textColor="@color/pinkRed"
                        android:textSize="8sp"
                        android:layout_marginTop="11dp"
                        app:layout_constraintTop_toBottomOf="@id/text_bank_desc"
                        app:layout_constraintStart_toStartOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
