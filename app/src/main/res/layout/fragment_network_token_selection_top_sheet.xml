<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/layout_network_selection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/rounded_border_midnight"
        android:padding="16dp">

        <!-- Title -->
        <TextView
                android:id="@+id/text_select_network_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit_light"
                android:text="Select Network"
                android:textColor="@color/goldenYellow"
                android:textSize="@dimen/sp_18"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        <!-- Warning Section -->
        <LinearLayout
                android:id="@+id/layout_network_warning"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:paddingVertical="@dimen/dp_10"
                android:paddingHorizontal="@dimen/dp_20"
                android:background="@drawable/rounded_golden_yellow_15pct"
                app:layout_constraintTop_toBottomOf="@id/text_select_network_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                        android:id="@+id/icon_network_warning"
                        android:layout_width="@dimen/dp_20"
                        android:layout_height="@dimen/dp_20"
                        android:src="@drawable/icon_info_circle"
                        android:layout_marginEnd="8dp" />

                <TextView
                        android:id="@+id/text_network_warning"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Ensure that the network matches the address and the deposit platform or assets may be lost."
                        android:textColor="@color/goldenYellow"
                        android:fontFamily="@font/kumbhsans_regular"
                        android:textSize="@dimen/sp_10" />
        </LinearLayout>

        <!-- RecyclerView for Networks -->
        <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_network_list"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scrollbars="vertical"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/layout_network_warning"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
