<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/layout_crypto_to_fiat"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/general_gradient_background"
        tools:context=".features.fiat.FiatToCryptoOnRampActivity">

    <!-- Top App Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/top_app_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <ImageView
                android:id="@+id/button_back"
                android:layout_width="24dp"
                android:layout_height="12dp"
                android:src="@drawable/icon_back"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        <TextView
                android:id="@+id/text_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="REQUEST"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:fontFamily="@font/kumbhsans_bold"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="12dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/button_back"
                app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
            app:layout_constraintTop_toBottomOf="@id/top_app_bar"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="26dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/containerNextTierInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingVertical="14dp"
                android:background="@drawable/rounded_golden_yellow_15pct"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                    android:id="@+id/tier_info_text_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                    <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/icon_info_circle" />

                    <TextView
                            android:id="@+id/currentTierLevel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:text="You are on Tier 2"
                            android:textSize="10sp"
                            android:textColor="@color/goldenYellow"
                            android:fontFamily="@font/kumbhsans_medium" />
                </LinearLayout>

                <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:orientation="vertical">

                    <TextView
                            android:id="@+id/text_limit_description"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Your daily credit and debit limit is set at "
                            android:textSize="10sp"
                            android:textColor="@color/white"
                            android:fontFamily="@font/kumbhsans_medium" />

                    <TextView
                            android:id="@+id/currentTierLimitAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="300,000 NGN."
                            android:layout_marginTop="3dp"
                            android:textSize="10sp"
                            android:textColor="@color/goldenYellow"
                            android:fontFamily="@font/kumbhsans_black" />
                </LinearLayout>
            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/button_upgrade_container"
                    android:layout_width="120dp"
                    android:layout_height="28dp"
                    android:background="@drawable/rounded_border_button_golden"
                    android:paddingVertical="4dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                        android:id="@+id/button_upgrade"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="UPGRADE"
                        android:textSize="10sp"
                        android:fontFamily="@font/kumbhsans_bold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Input Fields -->
        <LinearLayout
                android:id="@+id/input_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/containerNextTierInfo">

            <!-- Section Title -->
            <TextView
                    android:id="@+id/text_input_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Input purchase amount"
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/kumbhsans_regular" />

            <!-- CRYPTO INPUT -->
            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/container_crypto_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/rounded_border_midnight">

                <TextView
                        android:id="@+id/label_crypto_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Crypto Amount"
                        android:textSize="10sp"
                        android:textColor="@color/white"
                        android:fontFamily="@font/kumbhsans_light"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/crypto_amount_container"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:layout_constraintTop_toBottomOf="@id/label_crypto_amount"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                    <EditText
                            android:id="@+id/edittext_crypto_amount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:hint="0.00"
                            android:inputType="numberDecimal"
                            android:fontFamily="@font/outfit_bold"
                            android:textColor="@color/white"
                            android:textColorHint="@color/steelBlueGrey"
                            android:textSize="24sp"
                            android:background="@drawable/rounded_edittext_midnight_bg"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/crypto_spinner"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/crypto_spinner"
                            android:layout_width="112dp"
                            android:layout_height="46dp"
                            android:background="@drawable/rounded_border"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">

                        <ImageView
                                android:id="@+id/crypto_spinner_icon"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginEnd="8dp"
                                android:src="@drawable/icon_usdt"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent" />

                        <TextView
                                android:id="@+id/text_crypto_ticker"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="USDT"
                                android:layout_marginLeft="10dp"
                                android:textSize="10sp"
                                android:textColor="@color/steelBlueGrey"
                                android:fontFamily="@font/kumbhsans_regular"
                                app:layout_constraintStart_toEndOf="@id/crypto_spinner_icon"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- FIAT INPUT -->
            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/container_fiat_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/rounded_border_midnight">

                <TextView
                        android:id="@+id/label_fiat_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fiat Amount"
                        android:textSize="10sp"
                        android:textColor="@color/white"
                        android:fontFamily="@font/kumbhsans_light"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/fiat_amount_container"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:layout_constraintTop_toBottomOf="@id/label_fiat_amount"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                    <EditText
                            android:id="@+id/edittext_fiat_amount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:hint="0.00"
                            android:inputType="numberDecimal"
                            android:fontFamily="@font/outfit_bold"
                            android:textColor="@color/white"
                            android:textColorHint="@color/steelBlueGrey"
                            android:textSize="24sp"
                            android:background="@drawable/rounded_edittext_midnight_bg"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/fiat_spinner"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/fiat_spinner"
                            android:layout_width="112dp"
                            android:layout_height="46dp"
                            android:background="@drawable/rounded_border"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">

                        <ImageView
                                android:id="@+id/fiat_spinner_icon"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginEnd="8dp"
                                android:src="@drawable/icon_nigerian_flag"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent" />

                        <TextView
                                android:id="@+id/text_fiat_ticker"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="NGN"
                                android:textSize="10sp"
                                android:layout_marginLeft="10dp"
                                android:textColor="@color/steelBlueGrey"
                                android:fontFamily="@font/kumbhsans_regular"
                                app:layout_constraintStart_toEndOf="@id/fiat_spinner_icon"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/price_info_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/fiat_amount_container">

                    <LinearLayout
                            android:id="@+id/price_label_container"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">

                        <ImageView
                                android:id="@+id/icon_price_label"
                                android:layout_width="13dp"
                                android:layout_height="13dp"
                                android:src="@drawable/icon_info_circle"
                                android:contentDescription="Price Icon"
                                android:layout_marginEnd="4dp" />

                        <TextView
                                android:id="@+id/text_price_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Price"
                                android:textSize="10sp"
                                android:textColor="@color/white"
                                android:fontFamily="@font/kumbhsans_light" />
                    </LinearLayout>


                    <TextView
                            android:id="@+id/text_price_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="= 3,477 NGN/USDT"
                            android:textSize="14sp"
                            android:textColor="@color/white"
                            android:fontFamily="@font/kumbhsans_bold"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/nextButton"
                android:paddingHorizontal="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/button_ripple_golden_yellow"
                android:text="Next"
                android:elevation="0dp"
                android:fontFamily="@font/kumbhsans_bold"
                android:textColor="@color/dark_purple"
                android:textSize="10sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
