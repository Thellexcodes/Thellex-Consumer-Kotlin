<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/general_gradient_background"
        tools:context=".features.fiat.FiatToCryptoOnRampActivity">

    <include
            android:id="@+id/include_top_app_bar"
            layout="@layout/top_app_bar"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_uncompleted_transactions_wrapper"
            android:background="@drawable/rounded_border_bright_blue_sky"
            android:paddingHorizontal="14dp"
            app:layout_constraintTop_toBottomOf="@id/include_top_app_bar"
            android:layout_marginTop="@dimen/dp_26"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <LinearLayout
                android:id="@+id/layout_pending_transactions_info"
                android:paddingVertical="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent">

            <ImageView
                    android:id="@+id/icon_pending_clock"
                    android:src="@drawable/icon_clock"
                    android:layout_width="13dp"
                    android:layout_height="13dp"/>

            <TextView
                    android:id="@+id/text_pending_transactions_count"
                    android:textSize="12sp"
                    android:fontFamily="@font/kumbhsans_bold"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/darkBlue"
                    android:text="2 PENDING TRANSACTIONS"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
                android:id="@+id/layout_pending_transactions_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            <TextView
                    android:id="@+id/text_view_pending_transactions"
                    android:fontFamily="@font/kumbhsans_bold"
                    android:textSize="10sp"
                    android:text="VIEW"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            <ImageView
                    android:id="@+id/icon_arrow_right"
                    android:src="@drawable/icon_arror_right"
                    android:layout_width="13dp"
                    android:layout_height="13dp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
            app:layout_constraintTop_toBottomOf="@id/layout_uncompleted_transactions_wrapper"
            android:id="@+id/balanceOverview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginTop="17dp"
            android:background="@drawable/img_rounded_darkblue_bg"
            android:padding="10dp">

        <LinearLayout
                android:id="@+id/ticker_wallet_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent">

            <ImageView
                    android:id="@+id/assetFlag"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/icon_usdc" />

            <TextView
                    android:id="@+id/text_crypto_wallet_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/kumbhsans_semibold"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:text="" />
        </LinearLayout>

        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                    android:id="@+id/text_balance_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/kumbhsans_bold"
                    android:textColor="@color/white"
                    android:text="0.00"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            
            <ImageView
                    android:src="@drawable/icon_eye_open"
                    android:layout_marginStart="5dp"
                    android:layout_width="18dp"
                    android:layout_height="18dp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
            app:layout_constraintTop_toBottomOf="@id/balanceOverview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="21dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

