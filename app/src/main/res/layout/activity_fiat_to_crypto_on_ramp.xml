        <!-- Input Fields -->
        <LinearLayout
                android:id="@+id/input_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/dp_15"
                    android:background="@drawable/rounded_golden_yellow_15pct"
                    android:paddingHorizontal="15dp"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                        <ImageView
                                android:src="@drawable/icon_info_circle"
                                android:layout_width="15dp"
                                android:layout_height="15dp"/>
                        <TextView
                                android:textSize="8sp"
                                android:fontFamily="@font/kumbhsans_regular"
                                android:layout_marginLeft="@dimen/margin_7dp"
                                android:textColor="@color/white"
                                android:text="Only send funds from a bank account that matches your verified name on Thellex."
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- CRYPTO INPUT -->
            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/container_fiat_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/rounded_border_midnight">

                <TextView
                        android:id="@+id/label_crypto_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fiat Amount"
                        android:textSize="10sp"
                        android:textColor="@color/white"
                        android:fontFamily="@font/kumbhsans_light"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/crypto_amount_container"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:layout_constraintTop_toBottomOf="@id/label_crypto_amount"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                    <EditText
                            android:id="@+id/edittext_fiat_amount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:hint="0.00"
                            android:inputType="numberDecimal"
                            android:fontFamily="@font/outfit_bold"
                            android:textColor="@color/white"
                            android:textColorHint="@color/steelBlueGrey"
                            android:textSize="24sp"
                            android:background="@null"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/fiat_spinner"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/fiat_spinner"
                            android:layout_width="112dp"
                            android:layout_height="46dp"
                            android:background="@drawable/rounded_border"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">

                        <ImageView
                                android:id="@+id/crypto_fiat_icon"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginEnd="8dp"
                                android:src="@drawable/icon_nigerian_flag"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent" />

                        <TextView
                                android:id="@+id/text_fit_ticker"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="NGN"
                                android:layout_marginLeft="10dp"
                                android:textSize="10sp"
                                android:textColor="@color/steelBlueGrey"
                                android:fontFamily="@font/kumbhsans_regular"
                                app:layout_constraintStart_toEndOf="@id/crypto_fiat_icon"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- FIAT INPUT -->
            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/container_crypto_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/rounded_border_midnight">

                <TextView
                        android:id="@+id/label_fiat_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Crypto Amount"
                        android:textSize="10sp"
                        android:textColor="@color/white"
                        android:fontFamily="@font/kumbhsans_light"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/fiat_amount_container"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:layout_constraintTop_toBottomOf="@id/label_fiat_amount"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                    <EditText
                            android:id="@+id/edittext_crypto_amount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:hint="0.00"
                            android:inputType="numberDecimal"
                            android:fontFamily="@font/outfit_bold"
                            android:textColor="@color/white"
                            android:textColorHint="@color/steelBlueGrey"
                            android:textSize="24sp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/crypto_spinner"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/crypto_spinner"
                            android:layout_width="112dp"
                            android:layout_height="46dp"
                            android:background="@drawable/rounded_border"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">

                        <ImageView
                                android:id="@+id/assetIcon"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginEnd="8dp"
                                android:src="@drawable/icon_usdc"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent" />

                        <TextView
                                android:id="@+id/text_crypto_ticker"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="USDT"
                                android:layout_marginStart="10dp"
                                android:textSize="10sp"
                                android:textColor="@color/steelBlueGrey"
                                android:fontFamily="@font/kumbhsans_regular"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/assetIcon" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/price_info_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/fiat_amount_container">

                    <LinearLayout
                            android:id="@+id/price_label_container"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">

                        <ImageView
                                android:id="@+id/icon_price_label"
                                android:layout_width="13dp"
                                android:layout_height="13dp"
                                android:src="@drawable/icon_info_circle"
                                android:contentDescription="Price Icon"
                                android:layout_marginEnd="4dp" />

                        <TextView
                                android:id="@+id/text_price_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Price"
                                android:textSize="10sp"
                                android:textColor="@color/white"
                                android:fontFamily="@font/kumbhsans_light" />
                    </LinearLayout>


                    <TextView
                            android:id="@+id/text_price_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="≅ "
                            android:textSize="14sp"
                            android:textColor="@color/white"
                            android:fontFamily="@font/kumbhsans_bold"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                    android:id="@+id/secondary_bank_name_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                <TextView
                        android:id="@+id/label_secondary_bank_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:fontFamily="@font/kumbhsans_light"
                        android:textSize="10sp"
                        android:text="Reason"
                        android:textColor="@color/white" />

                <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/secondary_bank_name_input_wrapper"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                    <EditText
                            android:id="@+id/edittext_reason_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Select Reason"
                            android:textColorHint="@color/steelBlueGrey"
                            android:textSize="12sp"
                            android:fontFamily="@font/kumbhsans_regular"
                            android:textColor="@color/white"
                            android:background="@drawable/rounded_edittext_midnight_bg"
                            android:paddingVertical="15dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="48dp"
                            android:focusable="false"
                            android:clickable="true"
                            android:inputType="none"
                            android:cursorVisible="false"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />

                    <ImageView
                            android:id="@+id/icon_secondary_bank_dropdown"
                            android:layout_width="44dp"
                            android:layout_height="20dp"
                            android:contentDescription="Dropdown Arrow"
                            android:src="@drawable/icon_arrow_down"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/requestBvnBtn"
                android:visibility="gone"
                android:paddingHorizontal="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/button_ripple_golden_yellow"
                android:text="Submt Your Bank Verification Number"
                android:elevation="0dp"
                android:fontFamily="@font/kumbhsans_bold"
                android:textColor="@color/dark_purple"
                android:textSize="10sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        <androidx.appcompat.widget.AppCompatButton
                android:visibility="gone"
                android:id="@+id/nextButton"
                android:paddingHorizontal="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/button_ripple_golden_yellow"
                android:text="Next"
                android:elevation="0dp"
                android:fontFamily="@font/kumbhsans_bold"
                android:textColor="@color/dark_purple"
                android:textSize="10sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
