<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_border_midnight"
        android:padding="16dp">

    <!-- Search Input -->
    <EditText
            android:id="@+id/edittext_search_token"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Search tokens..."
            android:inputType="text"
            android:textColor="@color/white"
            android:textColorHint="@color/steelBlueGrey"
            android:textSize="14sp"
            android:background="@drawable/rounded_edittext_midnight_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:fontFamily="@font/kumbhsans_regular"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    <!-- No Tokens Found Message -->
    <TextView
            android:id="@+id/textview_no_tokens_found"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No tokens found"
            android:textAppearance="?attr/textAppearanceBody1"
            android:textColor="@color/white"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/edittext_search_token"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp" />

    <!-- Token List -->
    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerview_tokens"
            android:layout_width="0dp"
            android:layout_height="250dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/edittext_search_token"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

</androidx.constraintlayout.widget.ConstraintLayout>
