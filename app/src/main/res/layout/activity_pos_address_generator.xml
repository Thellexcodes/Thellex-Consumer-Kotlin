    <!-- Wallet Address and Copy Action -->
    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/wallet_address_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_34"
            android:padding="@dimen/dp_13"
            android:background="@drawable/rounded_border"
            app:layout_constraintTop_toBottomOf="@id/qr_code_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
                android:id="@+id/wallet_address_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                    android:id="@+id/wallet_address_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/kumbhsans_bold"
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/white"
                    android:text="Wallet Address" />

            <TextView
                    android:id="@+id/wallet_address_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:fontFamily="@font/kumbhsans_regular"
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/white"
                    android:text="31j1oifuwfajsdlfuoaifasuoi" />
        </LinearLayout>

        <LinearLayout
                android:id="@+id/copy_address_action_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                    android:id="@+id/copy_address_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/kumbhsans_bold"
                    android:textSize="@dimen/sp_10"
                    android:textColor="@color/goldenYellow"
                    android:text="Copy" />

            <ImageView
                    android:id="@+id/copy_address_icon"
                    android:layout_width="@dimen/dp_16"
                    android:layout_height="@dimen/dp_16"
                    android:layout_marginStart="@dimen/dp_13"
                    android:src="@drawable/icon_copy" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>