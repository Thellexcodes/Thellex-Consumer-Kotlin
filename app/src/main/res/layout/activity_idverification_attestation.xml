<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/cl_id_verification_attestation"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/general_gradient_background"
        tools:context=".features.kyc.ui.idverification.IDVerificationAttestationActivity">

        <!-- Top App Bar -->
        <include
                android:id="@+id/id_attestation_top_app_bar"
                layout="@layout/top_app_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        <!-- Scrollable Content -->
        <ScrollView
                android:id="@+id/scroll_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:fillViewport="true"
                android:scrollbars="none"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/id_attestation_top_app_bar">

                <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="16dp">

                        <!-- Attestation Title & Subtitle -->
                        <LinearLayout
                                android:id="@+id/ll_attestation_title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:paddingStart="@dimen/dp_16"
                                android:paddingEnd="@dimen/dp_16"
                                app:layout_constraintTop_toTopOf="parent">

                                <TextView
                                        android:id="@+id/tv_attestation_subtitle"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/dp_5"
                                        android:fontFamily="@font/kumbhsans_regular"
                                        android:text="Review the following information and attest to it below."
                                        android:textColor="@color/steelBlueGrey"
                                        android:textSize="@dimen/sp_14" />
                        </LinearLayout>

                        <!-- Uploaded Documents Label -->
                        <LinearLayout
                                android:id="@+id/ll_uploaded_docs_header"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp_22"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="@dimen/dp_16"
                                android:paddingEnd="@dimen/dp_16"
                                app:layout_constraintTop_toBottomOf="@id/ll_attestation_title">

                                <ImageView
                                        android:id="@+id/iv_info_icon"
                                        android:layout_width="@dimen/dp_13"
                                        android:layout_height="@dimen/dp_13"
                                        android:src="@drawable/icon_info_circle" />

                                <TextView
                                        android:id="@+id/tv_uploaded_documents"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="@dimen/dp_11"
                                        android:text="UPLOADED DOCUMENTS"
                                        android:textColor="@color/steelBlueGrey" />
                        </LinearLayout>

                        <!-- ID Document Preview -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/cl_id_preview"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp_11"
                                android:background="@color/midnight"
                                android:padding="@dimen/dp_17"
                                app:layout_constraintTop_toBottomOf="@id/ll_uploaded_docs_header">

                                <TextView
                                        android:id="@+id/tv_id_preview_label"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/kumbhsans_bold"
                                        android:text="Front of ID Document"
                                        android:textAllCaps="true"
                                        android:textColor="@color/white"
                                        android:textSize="@dimen/sp_12"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintTop_toTopOf="parent" />

                                <ImageView
                                        android:id="@+id/iv_id_preview"
                                        android:layout_width="match_parent"
                                        android:layout_height="200dp"
                                        android:layout_marginTop="@dimen/dp_10"
                                        app:layout_constraintTop_toBottomOf="@id/tv_id_preview_label" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <!-- Photo Preview -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/cl_photo_preview"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp_11"
                                android:background="@color/midnight"
                                android:padding="@dimen/dp_17"
                                app:layout_constraintTop_toBottomOf="@id/cl_id_preview">

                                <TextView
                                        android:id="@+id/tv_photo_preview_label"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/kumbhsans_bold"
                                        android:text="Selfie Photo"
                                        android:textAllCaps="true"
                                        android:textColor="@color/white"
                                        android:textSize="@dimen/sp_12"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintTop_toTopOf="parent" />

                                <ImageView
                                        android:id="@+id/iv_photo_preview"
                                        android:layout_width="match_parent"
                                        android:layout_height="200dp"
                                        android:layout_marginTop="@dimen/dp_10"
                                        app:layout_constraintTop_toBottomOf="@id/tv_photo_preview_label" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <!-- Attestation Checkbox -->
                        <LinearLayout
                                android:id="@+id/ll_attestation_checkbox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp_22"
                                android:orientation="horizontal"
                                android:paddingStart="@dimen/dp_16"
                                android:paddingEnd="@dimen/dp_16"
                                app:layout_constraintTop_toBottomOf="@id/cl_photo_preview">

                                <CheckBox
                                        android:id="@+id/cb_attestation"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:buttonTint="@color/white" />

                                <TextView
                                        android:id="@+id/tv_attestation_text"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center_vertical"
                                        android:layout_marginStart="8dp"
                                        android:fontFamily="@font/kumbhsans_regular"
                                        android:text="I attest that the information provided is correct."
                                        android:textColor="@color/steelBlueGrey"
                                        android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Submit Button -->
                        <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_submit_attestation"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:layout_marginBottom="16dp"
                                android:background="@drawable/button_ripple_golden_yellow"
                                android:elevation="0dp"
                                android:fontFamily="@font/kumbhsans_bold"
                                android:text="Submit"
                                android:textColor="@color/dark_purple"
                                android:textSize="10sp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/ll_attestation_checkbox" />

                </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>