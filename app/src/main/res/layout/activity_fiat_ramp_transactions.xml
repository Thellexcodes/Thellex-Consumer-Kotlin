<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/general_gradient_background"
        tools:context=".features.fiat.FiatRampTransactionsActivity">

        <include
                android:id="@+id/include_top_app_bar"
                layout="@layout/top_app_bar"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
                android:id="@+id/container"
                app:layout_constraintTop_toBottomOf="@id/include_top_app_bar"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:orientation="vertical"
                android:layout_marginTop="26dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.tabs.TabLayout
                        android:id="@+id/tabLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:tabRippleColor="@android:color/transparent"
                        android:background="@android:color/transparent"
                        app:tabBackground="@android:color/transparent"
                        app:tabIndicatorHeight="0dp"
                        app:tabTextColor="@color/midnight"
                        app:tabPaddingStart="12dp"
                        app:tabPaddingEnd="12dp"
                        app:tabSelectedTextColor="@color/darkBlue"
                        app:tabContentStart="0dp" />

                <androidx.recyclerview.widget.RecyclerView
                        android:layout_marginTop="26dp"
                        android:id="@+id/transactionsRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
        </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
