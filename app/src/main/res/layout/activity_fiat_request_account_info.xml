<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/general_gradient_background"
        tools:context=".features.fiat.FiatToCryptoRequestAccountInfoActivity">

        <!-- Top App Bar -->
        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/top_app_bar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingVertical="12dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                    android:id="@+id/button_back"
                    android:layout_width="24dp"
                    android:layout_height="12dp"
                    android:src="@drawable/icon_back"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
            android:id="@+id/currencyInfo"
            app:layout_constraintTop_toBottomOf="@id/top_app_bar"
            android:orientation="horizontal"
            android:layout_marginTop="36dp"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
                <ImageView
                        android:src="@drawable/icon_nigerian_flag"
                        android:layout_width="28dp"
                        android:layout_height="28dp"/>
                <TextView
                        android:layout_marginLeft="10dp"
                        android:fontFamily="@font/kumbhsans_bold"
                        android:textSize="14sp"
                        android:textColor="@color/white"
                        android:text="Nigerian naira (NGN)"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
    </LinearLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contaienrexipire"
            app:layout_constraintTop_toBottomOf="@id/currencyInfo"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/kumbhsans_regular"
                    android:text="This payment link expires in "
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                        android:padding="15dp"
                        android:background="@drawable/rounded_border"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:textColor="@color/white"
                        android:fontFamily="@font/kumbhsans_bold"
                        android:textSize="12sp"
                        android:text="0:00"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/fiatAccountInfo"
            android:layout_width="match_parent"
            android:background="@drawable/rounded_border_midnight"
            android:paddingHorizontal="18dp"
            android:paddingVertical="13dp"
            android:layout_marginTop="22dp"
            app:layout_constraintTop_toBottomOf="@id/contaienrexipire"
            android:layout_height="wrap_content">

        <LinearLayout
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"

                app:layout_constraintBottom_toBottomOf="parent"
                android:id="@+id/linearLayout7">

            <TextView
                    android:fontFamily="@font/kumbhsans_light"
                    android:textSize="10sp"
                    android:textColor="@color/steelBlueGrey"
                    android:text="BANK ACCOUNT NUMBER"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            <androidx.constraintlayout.widget.ConstraintLayout
                    android:paddingTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                <TextView
                        android:id="@+id/accountNumber"
                        android:textSize="24dp"
                        android:fontFamily="@font/outfit_bold"
                        android:textColor="@color/white"
                        android:text="000000000"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        />

                <ImageView
                        android:src="@drawable/icon_copy"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                    android:textSize="10sp"
                    android:fontFamily="@font/kumbhsans_light"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/white"
                    android:text="FIRST_NAME LAST_NAME"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            <TextView
                    android:textSize="10sp"
                    android:layout_marginTop="24dp"
                    android:fontFamily="@font/kumbhsans_light"
                    android:textColor="@color/steelBlueGrey"
                    android:text="BANK NAME"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            <TextView
                    android:textSize="24sp"
                    android:fontFamily="@font/outfit_bold"
                    android:textColor="@color/white"
                    android:layout_marginTop="8dp"
                    android:text="REAL_BANK_NAME"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>


    <LinearLayout
            android:background="@drawable/rounded_golden_yellow_shape"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:gravity="center_horizontal"
            android:layout_height="wrap_content"
            android:paddingVertical="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <ImageView
                    android:src="@drawable/icon_share"
                    android:layout_marginRight="10dp"
                    android:layout_width="18dp"
                    android:layout_height="18dp" />
            <TextView
                    android:textSize="12sp"
                    android:fontFamily="@font/kumbhsans_bold"
                    android:text="SHARE PAYMENT LINK"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>