<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/general_gradient_background"
        tools:context=".features.fiat.FiatWithdrawActivity">

    <!-- Top App Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/top_app_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <ImageView
                android:id="@+id/button_back"
                android:layout_width="24dp"
                android:layout_height="12dp"
                android:src="@drawable/icon_back"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        <TextView
                android:id="@+id/text_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="SEND NIGERIAN NAIRA (NGN)"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:fontFamily="@font/kumbhsans_bold"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="12dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/button_back"
                app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/balanceOverview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/img_rounded_darkblue_bg"
            android:padding="18dp"
            app:layout_constraintTop_toBottomOf="@id/top_app_bar">

        <LinearLayout
                android:id="@+id/ticker_wallet_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent">

            <ImageView
                    android:id="@+id/image_naira_flag"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/icon_nigerian_flag" />

            <TextView
                    android:id="@+id/text_naira_wallet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/kumbhsans_semibold"
                    android:textSize="10sp"
                    android:textColor="@color/white"
                    android:text="Naira Wallet" />
        </LinearLayout>

        <TextView
                android:id="@+id/text_balance_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:fontFamily="@font/kumbhsans_bold"
                android:textColor="@color/white"
                android:text="0.00 NGN"
                app:layout_constraintTop_toBottomOf="@id/ticker_wallet_name"
                app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
            android:id="@+id/main_input_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="21dp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/balanceOverview">

        <LinearLayout
                android:id="@+id/bank_name_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

            <TextView
                    android:id="@+id/label_bank_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:fontFamily="@font/kumbhsans_light"
                    android:textSize="10sp"
                    android:text="BANK NAME"
                    android:textColor="@color/white" />

            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/bank_name_input_wrapper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                <EditText
                        android:id="@+id/edittext_bank_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Select Bank"
                        android:textColorHint="@color/steelBlueGrey"
                        android:textSize="12sp"
                        android:fontFamily="@font/kumbhsans_regular"
                        android:textColor="@color/white"
                        android:background="@drawable/rounded_edittext_midnight_bg"
                        android:paddingVertical="15dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="48dp"
                        android:focusable="false"
                        android:clickable="true"
                        android:inputType="none"
                        android:cursorVisible="false"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                <ImageView
                        android:id="@+id/icon_bank_dropdown"
                        android:layout_width="44dp"
                        android:layout_height="20dp"
                        android:contentDescription="Dropdown Arrow"
                        android:src="@drawable/icon_arrow_down"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

        <LinearLayout
                android:id="@+id/account_number_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="21dp"
                android:orientation="vertical"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

            <TextView
                    android:id="@+id/label_account_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:fontFamily="@font/kumbhsans_light"
                    android:textSize="10sp"
                    android:text="INPUT ACCOUNT NUMBER"
                    android:textColor="@color/white" />

            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/account_number_input_wrapper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                <EditText
                        android:id="@+id/edittext_account_number"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Input Account Number"
                        android:textColorHint="@color/steelBlueGrey"
                        android:textSize="12sp"
                        android:fontFamily="@font/kumbhsans_regular"
                        android:textColor="@color/white"
                        android:background="@drawable/rounded_edittext_midnight_bg"
                        android:paddingVertical="15dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="48dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:cursorVisible="true"
                        android:inputType="text"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />


                <ImageView
                        android:visibility="gone"
                        android:id="@+id/icon_account_dropdown"
                        android:layout_width="44dp"
                        android:layout_height="20dp"
                        android:contentDescription="Dropdown Arrow"
                        android:src="@drawable/icon_arrow_down"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                    android:layout_marginTop="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:fontFamily="@font/kumbhsans_light"
                    android:textSize="10sp"
                    android:text="YOUR NAME HERE"
                    android:textColor="@color/white" />
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/amount_input_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/rounded_border_midnight">

            <TextView
                    android:id="@+id/label_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/kumbhsans_light"
                    android:textSize="10sp"
                    android:text="AMOUNT"
                    android:textColor="@color/white"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/withdraw_amount_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@id/label_amount"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                <EditText
                        android:id="@+id/edittext_withdraw_amount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:hint="0.00"
                        android:textColor="@color/white"
                        android:textColorHint="@color/steelBlueGrey"
                        android:background="@drawable/rounded_edittext_midnight_bg"
                        android:inputType="numberDecimal"
                        android:fontFamily="@font/outfit_bold"
                        android:textSize="24sp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/balance_max_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:layout_constraintTop_toBottomOf="@id/withdraw_amount_container">

                <TextView
                        android:id="@+id/text_available_balance"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="AVAILABLE BALANCE: 0.00 NGN"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:fontFamily="@font/kumbhsans_light"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/button_max"
                        app:layout_constraintHorizontal_bias="0" />

                <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/button_max"
                        android:layout_width="41dp"
                        android:layout_height="22dp"
                        android:text="MAX"
                        android:textAllCaps="true"
                        android:textSize="10sp"
                        android:textColor="@color/white"
                        android:background="@drawable/rounded_badge_primary_bg"
                        android:fontFamily="@font/kumbhsans_regular"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
                android:id="@+id/secondary_bank_name_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="21dp"
                android:orientation="vertical"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

            <TextView
                    android:id="@+id/label_secondary_bank_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:fontFamily="@font/kumbhsans_light"
                    android:textSize="10sp"
                    android:text="Reason"
                    android:textColor="@color/white" />

            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/secondary_bank_name_input_wrapper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                <EditText
                        android:id="@+id/edittext_reason_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Select Reason"
                        android:textColorHint="@color/steelBlueGrey"
                        android:textSize="12sp"
                        android:fontFamily="@font/kumbhsans_regular"
                        android:textColor="@color/white"
                        android:background="@drawable/rounded_edittext_midnight_bg"
                        android:paddingVertical="15dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="48dp"
                        android:focusable="false"
                        android:clickable="true"
                        android:inputType="none"
                        android:cursorVisible="false"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                <ImageView
                        android:id="@+id/icon_secondary_bank_dropdown"
                        android:layout_width="44dp"
                        android:layout_height="20dp"
                        android:contentDescription="Dropdown Arrow"
                        android:src="@drawable/icon_arrow_down"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/nextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/button_ripple_golden_yellow"
            android:text="Send"
            android:elevation="0dp"
            android:fontFamily="@font/kumbhsans_bold"
            android:textColor="@color/dark_purple"
            android:textSize="10sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>