<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/root_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/general_gradient_background"
        android:padding="@dimen/dp_20"
        tools:context=".features.kyc.fragments.RequestBvnModalFragment">

    <!-- Title -->
    <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VERIFY YOUR BVN TO PROCEED"
            android:textColor="@color/white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    <!-- Warning Section -->
    <LinearLayout
            android:id="@+id/warn_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/rounded_golden_yellow_15pct"
            android:paddingVertical="@dimen/dp_17"
            android:paddingHorizontal="@dimen/dp_20"
            app:layout_constraintTop_toBottomOf="@id/tv_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
        <ImageView
                android:id="@+id/iv_notification_icon"
                android:layout_width="@dimen/dp_16"
                android:layout_height="@dimen/dp_16"
                android:src="@drawable/icon_notification"
                android:contentDescription="Notification Icon" />
        <TextView
                android:id="@+id/tv_warning_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_15"
                android:text="Don’t know your BVN? Dial *565# on your registered number."
                android:textSize="@dimen/sp_10"
                android:textColor="@color/goldenYellow" />
    </LinearLayout>

    <!-- Input Fields Container -->
    <LinearLayout
            android:id="@+id/input_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/warn_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <!-- BVN Input -->
        <TextView
                android:id="@+id/tv_bvn_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/kumbhsans_light"
                android:text="@string/bank_verification_number_caps"
                android:textSize="@dimen/sp_10"
                android:textColor="@color/steelBlueGrey" />
        <EditText
                android:id="@+id/et_bvn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="@dimen/dp_10"
                android:hint="Enter your BVN"
                android:background="@drawable/rounded_edittext"
                android:textSize="@dimen/sp_12"
                android:singleLine="true"
                android:maxLines="1"
                android:inputType="number"
                android:paddingVertical="15dp"
                android:fontFamily="@font/kumbhsans_regular"
                android:textColor="@color/white"
                android:textColorHint="@color/steelBlueGrey" />

        <!-- Phone Number Input -->
        <TextView
                android:id="@+id/tv_phone_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                android:fontFamily="@font/kumbhsans_light"
                android:text="PHONE NUMBER"
                android:textSize="@dimen/sp_10"
                android:textColor="@color/steelBlueGrey" />
        <LinearLayout
                android:id="@+id/phone_container"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="@dimen/dp_10"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/rounded_edittext"
                android:paddingVertical="15dp">
            <LinearLayout
                    android:id="@+id/country_picker_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true">
                <ImageView
                        android:id="@+id/iv_country_flag"
                        android:layout_width="@dimen/dp_16"
                        android:layout_height="@dimen/dp_16"
                        android:contentDescription="Country Flag"
                        android:src="@drawable/icon_nigerian_flag" />
                <TextView
                        android:id="@+id/tv_country_code"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/dp_14"
                        android:text="+234"
                        android:textSize="@dimen/sp_10"
                        android:textColor="@color/steelBlueGrey" />
                <ImageView
                        android:id="@+id/iv_arrow"
                        android:layout_width="@dimen/dp_16"
                        android:layout_height="@dimen/dp_16"
                        android:contentDescription="Expand"
                        android:src="@drawable/icon_arrow_down"
                        app:tint="@color/steelBlueGrey" />
            </LinearLayout>
            <EditText
                    android:id="@+id/et_phone_number"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp_12"
                    android:paddingVertical="0dp"
                    android:hint="Phone Number"
                    android:fontFamily="@font/kumbhsans_regular"
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/steelBlueGrey"
                    android:textColorHint="@color/steelBlueGrey"
                    android:inputType="phone"
                    android:background="@null" />
        </LinearLayout>
    </LinearLayout>

    <!-- Submit Button -->
    <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_submit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:text="Submit"
            android:background="@drawable/rounded_golden_yellow_shape"
            android:textColor="@color/white"
            android:fontFamily="@font/kumbhsans_bold"
            android:textSize="@dimen/sp_12"
            app:layout_constraintTop_toBottomOf="@id/input_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>