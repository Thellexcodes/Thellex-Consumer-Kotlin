<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/general_gradient_background"
        tools:context=".features.kyc.ui.basic.PassportActivity">

    <include
            android:id="@+id/passport_include_top_app_bar"
            layout="@layout/top_app_bar"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    <!-- Instructions -->
    <TextView
            android:id="@+id/instructionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Upload the data page of your international passport"
            android:textSize="14sp"
            android:textColor="@color/steelBlueGrey"
            android:fontFamily="@font/kumbhsans_regular"
            app:layout_constraintTop_toBottomOf="@id/passport_include_top_app_bar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="20dp" />

    <!-- Info Box -->
    <LinearLayout
            android:id="@+id/infoContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="7dp"
            android:paddingHorizontal="14dp"
            android:background="@drawable/rounded_golden_yellow_15pct"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/instructionText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/icon_info_circle"
                android:contentDescription="Info icon" />

        <TextView
                android:id="@+id/infoText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Cross-check your information to make sure it is accurate."
                android:textColor="@color/goldenYellow"
                android:textSize="10sp"
                android:fontFamily="@font/kumbhsans_regular" />
    </LinearLayout>

    <!-- Upload Front -->


    <!-- Passport Previews -->
    <LinearLayout
            android:id="@+id/passportPreviewContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/rounded_border_midnight"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp"
            app:layout_constraintTop_toBottomOf="@id/infoContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/uploadFrontContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_border_midnight"
                app:layout_constraintTop_toBottomOf="@id/infoContainer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

            <TextView
                    android:id="@+id/passportFrontLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="INTERNATIONAL PASSPORT"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:fontFamily="@font/kumbhsans_bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintHorizontal_bias="0" />

            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/uploadFrontButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:background="@drawable/rounded_button_bright_blue_sky"
                    app:layout_constraintTop_toTopOf="parent"
                    android:paddingVertical="5dp"
                    android:paddingHorizontal="13dp"
                    app:layout_constraintBottom_toBottomOf="parent">
                    <TextView
                            android:text="UPLOAD FILE"
                            android:textColor="@color/brightSkyBlue"
                            android:fontFamily="@font/kumbhsans_bold"
                            android:textSize="10sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>


        <TextView
                android:id="@+id/document_preview"
                android:text="DOCUMENT PREVIEW"
                android:layout_width="wrap_content"
                android:textColor="@color/white"
                android:layout_marginTop="13dp"
                android:visibility="gone"
                android:fontFamily="@font/kumbhsans_bold"
                android:textSize="10sp"
                android:layout_marginBottom="@dimen/padding_16dp"
                android:layout_height="wrap_content"/>

        <ImageView
                android:id="@+id/passportFrontPreview"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_weight="1"
                android:visibility="gone"
                android:scaleType="centerCrop"
                android:contentDescription="Front passport preview"
                android:background="@drawable/image_preview_background" />

        <ImageView
                android:visibility="gone"
                android:id="@+id/passportBackPreview"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:scaleType="centerCrop"
                android:contentDescription="Back passport preview"
                android:background="@drawable/image_preview_background" />
    </LinearLayout>

    <!-- Next Button -->
    <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/nextButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:background="@drawable/button_ripple_golden_yellow"
            android:text="Next"
            android:textColor="@color/dark_purple"
            android:textSize="12sp"
            android:elevation="2dp"
            android:fontFamily="@font/kumbhsans_bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="20dp" />
</androidx.constraintlayout.widget.ConstraintLayout>
