<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp"
        android:background="@drawable/general_gradient_background"
        tools:context=".features.kyc.ui.FaceVerificationActivity">

    <!-- Top App Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/activity_wallet_top_app_bar_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <ImageView
                android:id="@+id/activity_wallet_back_button"
                android:layout_width="24dp"
                android:layout_height="12dp"
                android:src="@drawable/icon_back"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        <TextView
                android:id="@+id/titleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="SELF VERIFICATION"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:fontFamily="@font/kumbhsans_bold"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="12dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/activity_wallet_back_button"
                app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Hand + Face Image -->
    <androidx.cardview.widget.CardView
            android:id="@+id/cardImgContainer"
            android:layout_width="158dp"
            android:layout_height="158dp"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:cardUseCompatPadding="true"
            app:cardPreventCornerOverlap="false"
            app:layout_constraintTop_toBottomOf="@id/activity_wallet_top_app_bar_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <ImageView
                android:id="@+id/ivSelfieCapture"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/img_hand_face" />
    </androidx.cardview.widget.CardView>

    <!-- Face Verification Texts -->
    <LinearLayout
            android:id="@+id/linearLayout6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@+id/cardImgContainer">

        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Face Verification"
                android:textColor="@color/white"
                android:textAlignment="center"
                android:gravity="center"
                android:textSize="18sp"
                android:fontFamily="@font/outfit_bold" />

        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your face needs to be verified against the information you have provided. Please follow the guidelines to ensure proper capture."
                android:textColor="@color/steelBlueGrey"
                android:textAlignment="center"
                android:gravity="center"
                android:textSize="12sp"
                android:fontFamily="@font/kumbhsans_regular"
                android:paddingTop="8dp" />
    </LinearLayout>

    <!-- Instructions Section -->
    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/rounded_border_midnight"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@+id/linearLayout6"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <TextView
                android:id="@+id/instructionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Instructions"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:fontFamily="@font/outfit_medium"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/instructionTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

            <!-- Instruction Item 1 -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/icon_bright" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Ensure your face is well-lit."
                        android:textColor="@color/steelBlueGrey"
                        android:textSize="13sp"
                        android:fontFamily="@font/kumbhsans_regular" />
            </LinearLayout>

            <!-- Instruction Item 2 -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/icon_bright" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Remove any glasses or hats."
                        android:textColor="@color/steelBlueGrey"
                        android:textSize="13sp"
                        android:fontFamily="@font/kumbhsans_regular" />
            </LinearLayout>

            <!-- Instruction Item 3 -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/icon_bright" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Hold your phone steady during capture."
                        android:textColor="@color/steelBlueGrey"
                        android:textSize="13sp"
                        android:fontFamily="@font/kumbhsans_regular" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Button -->
    <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/startButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/button_ripple_golden_yellow"
            android:text="Submit"
            android:elevation="2dp"
            android:fontFamily="@font/kumbhsans_bold"
            android:textColor="@color/dark_purple"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
